# Emrecode Docker Deployment Configuration
# Copy to .env and customize for your environment

# Derviş Identity
DERVISH_ID=dervis-001
DERVISH_PROFILE=general
ORG_ID=org_local
PROJECT_ID=project_local

# Hub Connection
HUB_URL=http://dergah-gate:9860
FLEET_TOKEN_FILE=./.fleet-token

# vCenter/ESXi Integration (optional)
VCENTER_HOST=
VCENTER_USER=
VCENTER_PASS=
VCENTER_INSECURE=true

# Ollama Configuration
OLLAMA_HOST=http://ollama:11434
OLLAMA_CPU=6
OLLAMA_MEMORY=32G
OLLAMA_CPU_RESERVE=4
OLLAMA_MEMORY_RESERVE=24G

# Database
DB_URL=sqlite+aiosqlite:////data/emrecode.db
DB_AUTO_CREATE=true
DB_VOLUME_SIZE=2G

# Resource Limits per Derviş
RESOURCE_CPU=2
RESOURCE_MEMORY=2G
RESOURCE_CPU_RESERVE=1
RESOURCE_MEMORY_RESERVE=1G

# Workspace Path (on host or NFS)
WORKSPACE_PATH=/data/emrecode_workspace

# Port Mapping (per instance)
LISTEN_PORT=9870

# Logging
LOG_LEVEL=INFO
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5
