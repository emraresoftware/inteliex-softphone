<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 ve öncesi için yedekleme kuralları.
    FlutterSecureStorage verileri hariç tutulur (güvenlik gereği).
    SharedPreferences (hesap meta ve mirror şifreler) yedeklenir.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    <exclude domain="sharedpref" path="abto_phone"/>
    <exclude domain="database" path=""/>
    <exclude domain="file" path=""/>
</full-backup-content>
