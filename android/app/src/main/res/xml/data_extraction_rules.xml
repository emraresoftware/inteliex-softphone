<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ yedekleme kuralları.
    Hesap meta verisi (SharedPreferences) yedeklenir,
    FlutterSecureStorage (Keystore şifreler) zaten otomatik hariç tutulur.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Gizli depolama: Android zaten otomatik olarak hariç tutar -->
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
        <!-- ABTO SDK verileri -->
        <exclude domain="sharedpref" path="abto_phone"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
        <exclude domain="sharedpref" path="abto_phone"/>
    </device-transfer>
</data-extraction-rules>
